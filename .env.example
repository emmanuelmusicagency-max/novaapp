# ---------------------------------------------------------------------------
# NovaBank Environment Variables
# Copy this file to .env and fill in real values before running the app.
# ---------------------------------------------------------------------------

# Database (PostgreSQL connection string)
DATABASE_URL="postgresql://user:password@localhost:5432/novabank?schema=public"

# Auth / JWT
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
JWT_REFRESH_EXPIRES_IN="30d"

# NextAuth-style session cookie
SESSION_COOKIE_NAME="novabank_session"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="NovaBank"
NODE_ENV="development"

# Email (transactional email provider, e.g. Resend/SendGrid)
EMAIL_FROM="NovaBank <no-reply@novabank.io>"
EMAIL_API_KEY="replace-with-provider-api-key"

# OTP / 2FA
OTP_EXPIRY_MINUTES="10"
TOTP_ISSUER="NovaBank"

# Market data provider (for live crypto prices)
MARKET_DATA_API_URL="https://api.coingecko.com/api/v3"
MARKET_DATA_API_KEY=""

# Rate limiting / security
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="100"
